rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Existing subjects and questions (admin managed)
    match /subjects/{subjectId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == "PMbrCOTH61ZegHUTe2xVqDnidUm2";
      
      match /questions/{questionId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == "PMbrCOTH61ZegHUTe2xVqDnidUm2";
      }
    }
    
    // Existing attempts
    match /attempts/{attemptId} {
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow read: if request.auth != null && (resource.data.uid == request.auth.uid || request.auth.uid == "PMbrCOTH61ZegHUTe2xVqDnidUm2");
      allow update, delete: if request.auth != null && request.auth.uid == "PMbrCOTH61ZegHUTe2xVqDnidUm2";
    }

    function isValidTargetExams(data) {
      return !('targetExams' in data) 
        || (data.targetExams is list 
            && data.targetExams.size() <= 6 
            && data.targetExams.toSet().hasOnly(['jkssb_faa', 'jkssb_si', 'jk_bank_po', 'ibps_po', 'upsc_cse', 'jkpsc_cce']));
    }

    // User Profiles (Batch 1 & 2)
    match /users/{userId} {
      // Students can only read and write their own profile
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null 
                            && request.auth.uid == userId
                            && isValidTargetExams(request.resource.data);
      allow delete: if false;
    }

    // Username reservation index (enforces uniqueness at the database level)
    match /usernames/{usernameLower} {
      allow read: if request.auth != null;
      allow write: if request.auth != null 
                    && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null 
                    && resource.data.uid == request.auth.uid;
    }
  }
}
